// Configuración de Cloudflare Workers: publica la web compilada (carpeta dist) como archivos estáticos.
// "name" tiene que coincidir con el nombre del proyecto en Cloudflare.
{
  "name": "josevillarcorrales",
  "compatibility_date": "2026-10-01",
  // Publica la web en la dirección gratuita <nombre>.<subdominio>.workers.dev
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
